---
import "../styles/global.css";
import { siteUrl } from "../lib/config";

interface Props {
  title: string;
  description: string;
  path?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path = "/", structuredData } = Astro.props;
const canonical = new URL(path, siteUrl).toString();
const jsonLd = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/djinbar-symbol.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/djinbar-symbol.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Djinbar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd.map((entry) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
