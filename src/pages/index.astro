---
import BaseLayout from "../layouts/BaseLayout.astro";
import { chromeStoreUrl, siteUrl } from "../lib/config";

const title = "Djinbar — The bookmarks bar, rethought.";
const description =
  "Turn your bookmarks bar into contextual workspaces, always within reach while you browse.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Djinbar",
  applicationCategory: "BrowserApplication",
  operatingSystem: "Chrome",
  description,
  url: siteUrl,
};
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Djinbar home">
      <img src="/brand/djinbar-logo.png" alt="Djinbar" width="2172" height="724" />
    </a>
    <a
      class:list={["header-cta", { disabled: !chromeStoreUrl }]}
      href={chromeStoreUrl ?? "#hero"}
      aria-disabled={!chromeStoreUrl ? "true" : undefined}
    >
      Add to Chrome
    </a>
  </header>

  <main id="main">
    <section class="hero" id="hero">
      <div class="hero-copy">
        <p class="eyebrow">Chrome extension</p>
        <h1 class="visually-hidden">Djinbar</h1>
        <div class="brand-animation" aria-hidden="true">
          <div class="symbol-stage">
            <span class="intro-spark"></span>
            <img
              class="animated-symbol"
              src="/brand/djinbar-symbol.png"
              alt=""
              width="1254"
              height="1254"
            />
          </div>
          <img
            class="animated-wordmark"
            src="/brand/djinbar-wordmark.png"
            alt=""
            width="2172"
            height="724"
          />
        </div>
        <p class="tagline">The bookmarks bar, rethought.</p>
        <p class="lede">{description}</p>
        <a
          class:list={["primary-cta", { disabled: !chromeStoreUrl }]}
          href={chromeStoreUrl ?? "#hero"}
          aria-disabled={!chromeStoreUrl ? "true" : undefined}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 8.66 15H12a5 5 0 0 1-4.33-7.5L5.17 5.17A9.96 9.96 0 0 0 12 2Z" />
            <path d="M12 2a10 10 0 0 1 8.66 5H12a5 5 0 0 0-4.33 2.5L5.17 5.17A9.96 9.96 0 0 1 12 2Z" />
            <path d="M20.66 7A10 10 0 0 1 20.66 17H12a5 5 0 0 0 0-10h8.66Z" />
            <circle cx="12" cy="12" r="3.1" />
          </svg>
          Add to Chrome
        </a>
        {!chromeStoreUrl && <p class="availability">Chrome Web Store link coming soon.</p>}
      </div>

    </section>
  </main>

  <footer>
    <img src="/brand/djinbar-wordmark.png" alt="Djinbar" width="2172" height="724" />
    <span>© 2026</span>
    <span>Independent technical preview.</span>
  </footer>
</BaseLayout>
